# Inkwell environment variables
# Copy to .env.local for your personal local build. .env.local is gitignored.

# Your Anthropic API key, used by the Writing Coach.
# LOCAL ONLY — Vite bakes VITE_* vars into the built bundle, so do NOT set this
# on Vercel or any public deploy (it would ship to every visitor). On the demo,
# leave this unset; visitors add their own key in Settings.
# The in-app Settings key (if set) takes precedence over this.
VITE_ANTHROPIC_KEY=sk-ant-...

# Demo mode: seeds fictional sample data into a separate database. This is the
# ONLY var that's safe to set on Vercel (it's not a secret). build:demo sets it.
# VITE_DEMO_MODE=1
