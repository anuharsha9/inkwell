{
  "name": "inkwell",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A personal article archive & publishing queue — Moleskine for the screen.",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO_MODE=1 vite --port 3121",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && VITE_DEMO_MODE=1 vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@xenova/transformers": "^2.17.2",
    "compromise": "^14.15.1",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.9"
  }
}
